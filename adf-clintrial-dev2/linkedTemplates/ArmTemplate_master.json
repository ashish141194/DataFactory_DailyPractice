{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-clintrial-dev2"
		},
		"RestService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'RestService'"
		},
		"ls_Azure_SQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_Azure_SQL'"
		},
		"ls_adls_Parameterized_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_Parameterized'"
		},
		"ls_adls_gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_gen2'"
		},
		"RestService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/posts"
		},
		"RestService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "aa"
		},
		"ls_Azure_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-clintrial-dev.database.windows.net"
		},
		"ls_Azure_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-clintrial-dev"
		},
		"ls_Azure_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSAb52df281"
		},
		"ls_adls_Parameterized_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stclintrialdev2.dfs.core.windows.net/"
		},
		"ls_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stclintrialdev2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-clintrial-dev2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"RestService_password": {
						"value": "[parameters('RestService_password')]"
					},
					"ls_Azure_SQL_password": {
						"value": "[parameters('ls_Azure_SQL_password')]"
					},
					"ls_adls_Parameterized_accountKey": {
						"value": "[parameters('ls_adls_Parameterized_accountKey')]"
					},
					"ls_adls_gen2_accountKey": {
						"value": "[parameters('ls_adls_gen2_accountKey')]"
					},
					"RestService_properties_typeProperties_url": {
						"value": "[parameters('RestService_properties_typeProperties_url')]"
					},
					"RestService_properties_typeProperties_userName": {
						"value": "[parameters('RestService_properties_typeProperties_userName')]"
					},
					"ls_Azure_SQL_properties_typeProperties_server": {
						"value": "[parameters('ls_Azure_SQL_properties_typeProperties_server')]"
					},
					"ls_Azure_SQL_properties_typeProperties_database": {
						"value": "[parameters('ls_Azure_SQL_properties_typeProperties_database')]"
					},
					"ls_Azure_SQL_properties_typeProperties_userName": {
						"value": "[parameters('ls_Azure_SQL_properties_typeProperties_userName')]"
					},
					"ls_adls_Parameterized_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_Parameterized_properties_typeProperties_url')]"
					},
					"ls_adls_gen2_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_gen2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-clintrial-dev2_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-clintrial-dev2_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-clintrial-dev2_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-clintrial-dev2_ArmTemplate_1')]"
			]
		}
	]
}