{
	"name": "dataflow_std_colg_load",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_adls_gen2",
						"type": "LinkedServiceReference"
					},
					"name": "StdData"
				},
				{
					"linkedService": {
						"referenceName": "ls_adls_gen2",
						"type": "LinkedServiceReference"
					},
					"name": "ColgData"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_Azure_SQL",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {_col0_} as string,",
				"          {_col1_} as string,",
				"          {_col2_} as string,",
				"          {_col3_} as string,",
				"          {_col4_} as string,",
				"          {_col5_} as string,",
				"          {_col6_} as string,",
				"          {_col7_} as string,",
				"          {_col8_} as string,",
				"          {_col9_} as string,",
				"          {_col10_} as string,",
				"          {_col11_} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'cr-clintrial',",
				"     folderPath: 'sourcefiles/Inbound',",
				"     fileName: 'student_details_20261120.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: false) ~> StdData",
				"source(output(",
				"          College_ID as string,",
				"          College_Name as string,",
				"          Area as string,",
				"          City as string,",
				"          State as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'cr-clintrial',",
				"     folderPath: 'sourcefiles/Inbound',",
				"     fileName: 'college_master_details.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> ColgData",
				"StdData select(mapColumn(",
				"          Student_ID = {_col0_},",
				"          College_ID = {_col1_},",
				"          First_Name = {_col2_},",
				"          Last_Name = {_col3_},",
				"          Gender = {_col4_},",
				"          Date_of_Birth = {_col5_},",
				"          Email = {_col6_},",
				"          Phone = {_col7_},",
				"          Program = {_col8_},",
				"          Department = {_col9_},",
				"          Admission_Year = {_col10_},",
				"          City = {_col11_}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sort(asc(College_ID, true),",
				"     asc(City, true)) ~> sort1",
				"sort1 derive(Load_Date = fromUTC(currentUTC(), 'Asia/Kolkata'),",
				"          Loaded_by = 'ADF_User') ~> derivedColumn1",
				"derivedColumn1 keyGenerate(output(ADF_Load_ID as long),",
				"     startAt: 1001L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 select(mapColumn(",
				"          ADF_Load_ID,",
				"          Student_ID,",
				"          College_ID,",
				"          First_Name,",
				"          Last_Name,",
				"          Gender,",
				"          Date_of_Birth,",
				"          Email,",
				"          Phone,",
				"          Program,",
				"          Department,",
				"          Admission_Year,",
				"          City,",
				"          Load_Date,",
				"          Loaded_by",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, ColgData join(select2@College_ID == ColgData@College_ID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'StudentMasterData',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ADF_Load_ID,",
				"          Student_ID,",
				"          College_ID = select2@College_ID,",
				"          First_Name,",
				"          Last_Name,",
				"          Gender,",
				"          Date_of_Birth,",
				"          Email,",
				"          Phone,",
				"          Program,",
				"          Department,",
				"          Admission_Year,",
				"          City = select2@City,",
				"          Load_Date,",
				"          Loaded_by,",
				"          College_ID = ColgData@College_ID,",
				"          College_Name,",
				"          Area,",
				"          City = ColgData@City,",
				"          State",
				"     )) ~> sink1"
			]
		}
	}
}