					"dataset": {
						"referenceName": "ds_adls_global_trigger",
						"type": "DatasetReference"
					},
					"timeout": "0.12:00:00",
					"sleep": 10
				}
			}
		],
		"variables": {
			"vFileName": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Multiple_Activity_Practice"
