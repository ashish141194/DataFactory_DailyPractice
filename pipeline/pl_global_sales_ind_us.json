										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@if(\n    contains(item().name,'IND'),\n    'IND',\n    if(\n        contains(item().name,'US'),\n        'US',\n        ''\n    )\n)",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "IND",
										"activities": [
											{
												"name": "Copy_India_files",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [
													{
														"name": "Source",
														"value": "cr-clintrial/Global_Sales/@{variables('vFileName')}"
